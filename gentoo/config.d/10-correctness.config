# # ============================================
# # Machine-check handling + AMD error decoding.
# # ============================================
# # Allows CPU to notify the kernel of hardware errors.
CONFIG_X86_MCE=y
# # AMD-specific hardware error reporting.
CONFIG_X86_MCE_AMD=y
# # Human-readable cache failure logs. Built in (y, not m) so errors that occur
# # early in boot, before modules load, are decoded too.
# # NOTE: Could be potentially disabled if no ECC RAM.
CONFIG_EDAC_DECODE_MCE=y

# # ==================================
# # Intel-only machine-check handling.
# # ==================================
# CONFIG_X86_MCE_INTEL is not set
# CONFIG_ACPI_EXTLOG is not set

# # =========================================================
# # Disable correctness settings which only apply to ECC RAM.
# # =========================================================
# # DRAM ECC error reporting.
# CONFIG_EDAC_AMD64 is not set
# # Collects correctable memory errors (an ECC feature).
# CONFIG_RAS_CEC is not set
# # Without ECC, memory-failure recovery is useful only for testing.
# CONFIG_MEMORY_FAILURE is not set
# # Address translation library. Only used for ECC errors.
# CONFIG_AMD_ATL is not set
# # Persists memory errors reported by ECC.
# CONFIG_RAS_FMPM is not set

# # ====================================
# # Disable unnecessary debugging tools.
# # ====================================
# # No need for live kernel debugging.
# CONFIG_KGDB is not set
# # x86 instruction decoder sanity check only needed by kernel devs
# CONFIG_X86_DECODER_SELFTEST is not set
# # MCE injection only needed for low-level kernel testing.
# CONFIG_X86_MCE_INJECT is not set
# # /dev/mcelog has been deprecated. Only for legacy testing.
# CONFIG_X86_MCELOG_LEGACY is not set

# # This machine hosts KVM guests, so it needs the VMSCAPE mitigation.
# # A kernel vulnerability check reported "Vulnerable" for VMSCAPE.
CONFIG_MITIGATION_VMSCAPE=y
